# Use CUDA-compatible base image for GPU support, but also works on CPU
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies including CUDA-compatible packages
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better Docker layer caching
COPY requirements.txt .

# Install Python dependencies with GPU support
RUN pip install --no-cache-dir -r requirements.txt

# Install PyTorch with CUDA support (this will also work on CPU)
# The version should match your requirements.txt, but ensure it has CUDA support
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

# Create model directory (this will NOT be overridden by volume mount)
RUN mkdir -p /app/models

# Set environment variables for model download and caching
ENV HF_HOME=/app/models
ENV TRANSFORMERS_CACHE=/app/models
ENV HF_DATASETS_CACHE=/app/models
ENV TORCH_HOME=/app/models

# GPU-related environment variables (can be overridden by docker-compose)
ENV CUDA_VISIBLE_DEVICES=""
ENV FORCE_CPU=1
ENV USE_GPU=0

# Copy the model download script
COPY app/utils/download_model.py /app/utils/download_model.py

# Download the model during build (requires HF token as build arg)
ARG HUGGINGFACE_TOKEN
ENV HUGGINGFACE_TOKEN=${HUGGINGFACE_TOKEN}

# Run the download script
RUN python /app/utils/download_model.py

# Create necessary directories for the app
RUN mkdir -p /app/api /app/core /app/db /app/models /app/service /app/utils /app/classes

# Copy application code (this will be overridden by volume mount in dev)
# COPY ./app /app/

# Expose port
EXPOSE 8085

# Health check to verify the container is working
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8085/health || exit 1

# Run the application with hot reloading
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8085", "--reload"]